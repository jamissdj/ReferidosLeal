<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Referidos Leal — Banco de Talento</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,400&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #F0F2F7;
    --surface: #FFFFFF;
    --surface2: #F7F8FC;
    --border: #E4E7EF;
    --text: #111827;
    --text-2: #4B5563;
    --text-3: #9CA3AF;
    --accent: #2B4EE6;
    --accent-light: #EEF2FF;
    --disponible: #059669;
    --disponible-bg: #ECFDF5;
    --proceso: #D97706;
    --proceso-bg: #FFFBEB;
    --contratado: #7C3AED;
    --contratado-bg: #F5F3FF;
    --rechazado: #9CA3AF;
    --rechazado-bg: #F9FAFB;
    --desistio: #EA580C;
    --desistio-bg: #FFF7ED;
    --radius: 12px;
    --radius-sm: 6px;
    color-scheme: light;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }
  header { background: var(--surface); border-bottom: 1px solid var(--border); padding: 0 32px; position: sticky; top: 0; z-index: 100; }
  .header-inner { max-width: 1280px; margin: 0 auto; display: flex; align-items: center; gap: 32px; height: 64px; }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; flex-shrink: 0; }
  .logo-mark { width: 34px; height: 34px; background: var(--accent); border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #fff; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 15px; letter-spacing: -0.5px; }
  .logo-text { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 15px; color: var(--text); line-height: 1.2; }
  .logo-sub { font-size: 11px; font-weight: 400; color: var(--text-3); }
  .header-stats { display: flex; gap: 24px; margin-left: auto; }
  .stat { text-align: center; }
  .stat-num { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 18px; line-height: 1; color: var(--text); }
  .stat-label { font-size: 11px; color: var(--text-3); margin-top: 2px; white-space: nowrap; }
  .stat-num.disp { color: var(--disponible); }
  .stat-num.proc { color: var(--proceso); }
  .stat-num.cont { color: var(--contratado); }
  .toolbar { max-width: 1280px; margin: 28px auto 0; padding: 0 32px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .search-wrap { position: relative; flex: 1; min-width: 220px; }
  .search-icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-3); pointer-events: none; }
  .search-input { width: 100%; padding: 10px 12px 10px 36px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); font-family: 'DM Sans', sans-serif; font-size: 14px; color: var(--text); outline: none; transition: border-color 0.15s; }
  .search-input:focus { border-color: var(--accent); }
  .search-input::placeholder { color: var(--text-3); }
  .filter-pills { display: flex; gap: 6px; flex-wrap: wrap; }
  .pill { padding: 8px 14px; border-radius: 20px; border: 1.5px solid var(--border); background: var(--surface); font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 500; color: var(--text-2); cursor: pointer; transition: all 0.15s; white-space: nowrap; }
  .pill:hover { border-color: var(--accent); color: var(--accent); }
  .pill.active { background: var(--accent); border-color: var(--accent); color: #fff; }
  .pill.active.disponible { background: var(--disponible); border-color: var(--disponible); }
  .pill.active.proceso { background: var(--proceso); border-color: var(--proceso); }
  .pill.active.contratado { background: var(--contratado); border-color: var(--contratado); }
  .pill.active.rechazado { background: #6B7280; border-color: #6B7280; }
  .pill.active.desistio { background: var(--desistio); border-color: var(--desistio); }
  .pill.cargo { font-size: 12px; padding: 5px 11px; }
  .pill.cargo.active { background: #6366F1; border-color: #6366F1; color: #fff; }
  .pill.cargo:hover { border-color: #6366F1; color: #6366F1; }
  .filter-bar { max-width: 1280px; margin: 8px auto 0; padding: 0 32px; display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
  .filter-bar-label { font-size: 11.5px; font-weight: 600; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.05em; margin-right: 4px; white-space: nowrap; }
  .results-count { font-size: 13px; color: var(--text-3); margin-left: auto; white-space: nowrap; }
  .grid { max-width: 1280px; margin: 20px auto 60px; padding: 0 32px; display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 16px; }
  .card { background: var(--surface); border-radius: var(--radius); border: 1px solid var(--border); overflow: hidden; cursor: pointer; transition: transform 0.15s, box-shadow 0.15s; display: flex; flex-direction: column; }
  .card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.08); }
  .card-stripe { height: 4px; width: 100%; flex-shrink: 0; }
  .card-stripe.disponible { background: var(--disponible); }
  .card-stripe.en-proceso { background: var(--proceso); }
  .card-stripe.contratado { background: var(--contratado); }
  .card-stripe.rechazado { background: var(--rechazado); }
  .card-stripe.desistio { background: var(--desistio); }
  .card-body { padding: 18px 20px 16px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
  .card-name { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 15px; line-height: 1.3; color: var(--text); }
  .badge { display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px; border-radius: 20px; font-size: 11.5px; font-weight: 600; white-space: nowrap; flex-shrink: 0; }
  .badge::before { content: ''; display: block; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .badge.disponible { background: var(--disponible-bg); color: var(--disponible); }
  .badge.en-proceso { background: var(--proceso-bg); color: var(--proceso); }
  .badge.contratado { background: var(--contratado-bg); color: var(--contratado); }
  .badge.rechazado { background: var(--rechazado-bg); color: var(--rechazado); }
  .badge.desistio { background: var(--desistio-bg); color: var(--desistio); }
  .card-cargo { font-size: 12.5px; font-weight: 500; color: var(--accent); background: var(--accent-light); display: inline-block; padding: 2px 8px; border-radius: 4px; align-self: flex-start; }
  .card-meta { display: flex; gap: 16px; font-size: 12.5px; color: var(--text-2); }
  .card-meta span { display: flex; align-items: center; gap: 4px; }
  .card-resumen { font-size: 13px; color: var(--text-2); line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .card-footer { padding: 12px 20px 14px; border-top: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; background: var(--surface2); }
  .ref-info { font-size: 11.5px; color: var(--text-3); }
  .fecha-ingreso { font-size: 11px; color: var(--text-3); margin-top: 3px; }
  .ref-info strong { color: var(--text-2); font-weight: 500; }
  .btn-ver { font-family: 'DM Sans', sans-serif; font-size: 12.5px; font-weight: 500; color: var(--accent); background: none; border: 1.5px solid var(--accent); border-radius: 6px; padding: 5px 12px; cursor: pointer; transition: all 0.15s; }
  .btn-ver:hover { background: var(--accent); color: #fff; }
  .btn-delete-card { background: none; border: none; cursor: pointer; color: #9CA3AF; font-size: 15px; padding: 4px 6px; border-radius: 5px; transition: all 0.15s; line-height: 1; }
  .btn-delete-card:hover { color: #EF4444; background: #FEF2F2; }
  .btn-delete-modal { background: #FEF2F2; color: #EF4444; border: 1.5px solid #FCA5A5; border-radius: 8px; padding: 10px 18px; font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500; cursor: pointer; transition: all 0.15s; }
  .btn-delete-modal:hover { background: #EF4444; color: #fff; border-color: #EF4444; }
  .btn-edit-modal { background: #EFF6FF; color: #2563EB; border: 1.5px solid #93C5FD; border-radius: 8px; padding: 10px 18px; font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500; cursor: pointer; transition: all 0.15s; }
  .btn-edit-modal:hover { background: #2563EB; color: #fff; border-color: #2563EB; }
  .empty { grid-column: 1 / -1; text-align: center; padding: 60px 20px; color: var(--text-3); }
  .empty-icon { font-size: 40px; margin-bottom: 12px; }
  .empty p { font-size: 15px; }
  .modal-overlay { position: fixed; inset: 0; background: rgba(15, 20, 40, 0.45); backdrop-filter: blur(4px); z-index: 200; display: none; align-items: center; justify-content: center; padding: 20px; }
  .modal-overlay.open { display: flex; }
  .modal { background: var(--surface); border-radius: 16px; width: 100%; max-width: 660px; max-height: 90vh; overflow-y: auto; box-shadow: 0 24px 64px rgba(0,0,0,0.18); }
  .modal-header { position: sticky; top: 0; background: var(--surface); padding: 22px 28px 18px; border-bottom: 1px solid var(--border); display: flex; align-items: flex-start; gap: 14px; z-index: 1; }
  .modal-header-text { flex: 1; }
  .modal-name { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 20px; color: var(--text); margin-bottom: 6px; }
  .modal-badges { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .btn-close { background: none; border: none; cursor: pointer; color: var(--text-3); padding: 4px; border-radius: 6px; transition: color 0.15s, background 0.15s; flex-shrink: 0; font-size: 20px; line-height: 1; }
  .btn-close:hover { color: var(--text); background: var(--bg); }
  .modal-body { padding: 24px 28px 28px; }
  .section-label { font-family: 'Space Grotesk', sans-serif; font-size: 10.5px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-3); margin-bottom: 8px; }
  .modal-section { margin-bottom: 22px; }
  .resumen-text { font-size: 14px; line-height: 1.65; color: var(--text-2); }
  .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .detail-item label { display: block; font-size: 11px; font-weight: 500; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 3px; }
  .detail-item span { font-size: 14px; color: var(--text); }
  .modal-actions { display: flex; gap: 10px; flex-wrap: wrap; padding-top: 20px; border-top: 1px solid var(--border); }
  .btn-action { flex: 1; min-width: 130px; padding: 11px 18px; border-radius: 8px; font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500; cursor: pointer; border: none; transition: all 0.15s; text-align: center; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 7px; }
  .btn-primary { background: var(--accent); color: #fff; }
  .btn-primary:hover { background: #1d3fc4; }
  .btn-proceso { background: var(--proceso-bg); color: var(--proceso); border: 1.5px solid var(--proceso); }
  .btn-rechazado { background: var(--rechazado-bg); color: #6B7280; border: 1.5px solid #D1D5DB; }
  .btn-rechazado:hover { background: #6B7280; color: #fff; border-color: #6B7280; }
  .btn-contratado { background: var(--contratado-bg); color: var(--contratado); border: 1.5px solid var(--contratado); }
  .btn-contratado:hover { background: var(--contratado); color: #fff; }
  .btn-desistio { background: var(--desistio-bg); color: var(--desistio); border: 1.5px solid var(--desistio); }
  .btn-desistio:hover { background: var(--desistio); color: #fff; }
  .estado-section-label { font-size: 11px; font-weight: 600; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 8px; }
  .btn-proceso:hover { background: var(--proceso); color: #fff; }
  .btn-proceso.active { background: var(--proceso); color: #fff; }
  .btn-secondary { background: var(--bg); color: var(--text-2); border: 1.5px solid var(--border); }
  .btn-secondary:hover { border-color: var(--text-2); color: var(--text); }
  .proceso-note { font-size: 12px; color: var(--text-3); margin-top: 8px; font-style: italic; }
  .historial-section { margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--border); }
  .historial-timeline { display: flex; flex-direction: column; gap: 0; margin-top: 10px; }
  .historial-item { display: flex; gap: 12px; position: relative; padding-bottom: 14px; }
  .historial-item:last-child { padding-bottom: 0; }
  .historial-dot-col { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
  .historial-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); flex-shrink: 0; margin-top: 3px; }
  .historial-dot.proceso { background: var(--proceso); }
  .historial-dot.disponible { background: var(--disponible); }
  .historial-dot.contratado { background: var(--contratado); }
  .historial-dot.rechazado { background: var(--rechazado); }
  .historial-dot.desistio { background: var(--desistio); }
  .historial-line { width: 2px; flex: 1; background: var(--border); margin-top: 4px; }
  .historial-item:last-child .historial-line { display: none; }
  .historial-content { flex: 1; }
  .historial-accion { font-size: 13px; font-weight: 600; color: var(--text); }
  .historial-meta { font-size: 11.5px; color: var(--text-3); margin-top: 2px; }
  .historial-empty { font-size: 13px; color: var(--text-3); font-style: italic; }
  .modal::-webkit-scrollbar { width: 6px; }
  .modal::-webkit-scrollbar-track { background: transparent; }
  .modal::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
  .btn-nuevo {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 9px 16px; border-radius: var(--radius-sm);
    background: var(--accent); color: #fff;
    font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 500;
    border: none; cursor: pointer; white-space: nowrap; transition: background 0.15s; flex-shrink: 0;
  }
  .btn-nuevo:hover { background: #1d3fc4; }

  .modal-nuevo { max-width: 540px; }

  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .form-full { grid-column: 1 / -1; }
  .form-group { display: flex; flex-direction: column; gap: 5px; }
  .form-group label { font-size: 11.5px; font-weight: 500; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.06em; }
  .form-group input, .form-group select, .form-group textarea {
    padding: 9px 12px; border: 1px solid var(--border); border-radius: var(--radius-sm);
    font-family: 'DM Sans', sans-serif; font-size: 14px; color: var(--text);
    background: var(--surface); outline: none; transition: border-color 0.15s;
  }
  .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: var(--accent); }
  .form-group textarea { resize: vertical; min-height: 80px; }
  .form-note { font-size: 12px; color: var(--text-3); margin-top: 4px; }
  .form-required { color: #EF4444; }

    .badge-local {
    display: inline-block; font-size: 10px; font-weight: 700;
    color: #2B4EE6; background: #EEF2FF;
    padding: 1px 6px; border-radius: 10px; margin-right: 4px;
  }
  #toast {
    position: fixed; bottom: 28px; left: 50%; transform: translateX(-50%) translateY(20px);
    background: #111827; color: #fff; font-size: 14px; font-weight: 500;
    padding: 12px 22px; border-radius: 8px; opacity: 0;
    transition: opacity 0.2s, transform 0.2s; pointer-events: none; z-index: 999;
    white-space: nowrap;
  }
  #toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  @media (max-width: 680px) {
    .header-stats { display: none; }
    .toolbar { padding: 0 16px; }
    .grid { padding: 0 16px; }
    .detail-grid { grid-template-columns: 1fr; }
    .modal { border-radius: 12px; }
    .modal-header, .modal-body { padding: 16px 18px; }
  }
.btn-download {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 9px 16px; border-radius: 6px;
  background: #fff; color: #2B4EE6;
  font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 500;
  border: 1.5px solid #2B4EE6; cursor: pointer; white-space: nowrap; flex-shrink: 0;
}
.btn-download:hover { background: #EEF2FF; }

  .alert-badge {
    display: inline-flex; align-items: center; justify-content: center;
    background: #EF4444; color: #fff; border-radius: 50%;
    font-size: 11px; font-weight: 700; min-width: 18px; height: 18px;
    padding: 0 4px; margin-left: 6px; line-height: 1;
    animation: pulse-badge 1.5s ease-in-out infinite;
  }
  @keyframes pulse-badge { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.8;transform:scale(1.15)} }
  .btn-referidos-alert {
    font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 600;
    background: #FEF2F2; color: #DC2626; border: 1.5px solid #DC2626;
    border-radius: 8px; padding: 7px 14px; cursor: pointer;
    display: none; align-items: center; gap: 4px; white-space: nowrap;
    transition: background 0.15s;
  }
  .btn-referidos-alert:hover { background: #DC2626; color: #fff; }
  .referidos-panel {
    position: fixed; top: 0; right: 0; bottom: 0; width: 420px; max-width: 95vw;
    background: #fff; border-left: 1px solid var(--border);
    box-shadow: -8px 0 32px rgba(0,0,0,0.12); z-index: 300;
    display: flex; flex-direction: column; transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(.4,0,.2,1);
  }
  .referidos-panel.open { transform: translateX(0); }
  .referidos-panel-header {
    padding: 20px 24px 16px; border-bottom: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between;
    background: var(--surface);
  }
  .referidos-panel-body { flex: 1; overflow-y: auto; padding: 16px 20px; }
  .ref-card {
    border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px;
    margin-bottom: 12px; background: var(--surface2); position: relative;
  }
  .ref-card.nuevo { border-left: 3px solid #2563EB; background: #EFF6FF; }
  .ref-card-name { font-size: 14px; font-weight: 600; color: var(--text); }
  .ref-card-meta { font-size: 12px; color: var(--text-3); margin-top: 3px; }
  .ref-card-nota { font-size: 12.5px; color: var(--text-2); margin-top: 8px; font-style: italic; }
  .ref-card-actions { margin-top: 10px; display: flex; gap: 8px; }
  .btn-visto { font-size: 12px; padding: 5px 12px; border-radius: 6px; border: 1.5px solid var(--border); background: #fff; cursor: pointer; color: var(--text-2); }
  .btn-visto:hover { background: #F3F4F6; }

</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
</head>
<body>

<header>
  <div class="header-inner">
    <a class="logo" href="#">
      <div class="logo-mark">RL</div>
      <div class="logo-text">
        Referidos Leal
        <div class="logo-sub">VP AI &amp; Advanced Analytics · Admin</div>
      </div>
    </a>
    <div class="header-stats">
      <div class="stat"><div class="stat-num" id="stat-total">—</div><div class="stat-label">Total</div></div>
      <div class="stat"><div class="stat-num disp" id="stat-disp">—</div><div class="stat-label">Disponibles</div></div>
      <div class="stat"><div class="stat-num proc" id="stat-proc">—</div><div class="stat-label">En proceso</div></div>
      <div class="stat"><div class="stat-num cont" id="stat-cont">—</div><div class="stat-label">Contratados</div></div>
      <div class="stat"><div class="stat-num" style="color:var(--rechazado)" id="stat-rech">—</div><div class="stat-label">Rechazados</div></div>
      <div class="stat"><div class="stat-num" style="color:var(--desistio)" id="stat-des">—</div><div class="stat-label">Desistieron</div></div>
      <button class="btn-referidos-alert" id="btn-referidos-alert" onclick="toggleReferidosPanel()">
        &#128276; Nuevos referidos <span class="alert-badge" id="referidos-badge">0</span>
      </button>
    </div>
  </div>
</header>

<div class="toolbar">
  <div class="search-wrap">
    <svg class="search-icon" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
    <input class="search-input" type="text" id="search" placeholder="Buscar por nombre, cargo, habilidades…">
  </div>
  <div class="filter-pills">
    <button class="pill active" data-estado="todos">Todos</button>
    <button class="pill disponible" data-estado="Disponible">Disponibles</button>
    <button class="pill proceso" data-estado="En proceso">En proceso</button>
    <button class="pill contratado" data-estado="Contratado">Contratados</button>
    <button class="pill rechazado" data-estado="Rechazado">Rechazados</button>
    <button class="pill desistio" data-estado="Desistió">Desistieron</button>
  </div>
  <div class="results-count" id="results-count"></div>
  <button class="btn-download" id="btn-publish" onclick="generarPublicable()" style="background:#F0FDF4;color:#059669;border-color:#059669;">
    &#10003; Generar HTML publicable
  </button>
  <select id="sort-select" style="padding:8px 12px;border:1px solid var(--border);border-radius:var(--radius-sm);font-family:'DM Sans',sans-serif;font-size:13px;color:var(--text-2);background:var(--surface);cursor:pointer;outline:none;">
    <option value="fecha-desc">Más recientes primero</option>
    <option value="fecha-asc">Más antiguos primero</option>
    <option value="alfa">Alfabético</option>
  </select>
  <button class="btn-download" id="btn-export-hist" onclick="exportarHistorial()" style="background:#EFF6FF;color:#2563EB;border-color:#2563EB;">
    &#8659; Exportar historial CSV
  </button>
  <button class="btn-download" id="btn-download" onclick="downloadReporte()">
    &#8595; Descargar reporte
  </button>
  <button class="btn-nuevo" id="btn-nuevo" onclick="openNuevo()">
    + Agregar candidato
  </button>
</div>
<div class="filter-bar" id="cargo-filter-bar">
  <span class="filter-bar-label">Cargo:</span>
  <button class="pill cargo active" data-cargo="todos">Todos</button>
</div>

<div class="grid" id="grid"></div>

<div class="modal-overlay" id="modal-overlay">
  <div class="modal" id="modal">
    <div class="modal-header">
      <div class="modal-header-text">
        <div class="modal-name" id="m-nombre"></div>
        <div class="modal-badges">
          <span class="badge" id="m-estado-badge"></span>
          <span class="card-cargo" id="m-cargo"></span>
        </div>
      </div>
      <button class="btn-close" id="btn-close">&#10005;</button>
    </div>
    <div class="modal-body">
      <div class="modal-section" id="m-resumen-section">
        <div class="section-label">Resumen</div>
        <p class="resumen-text" id="m-resumen"></p>
      </div>
      <div class="modal-section">
        <div class="section-label">Experiencia y formación</div>
        <div class="detail-grid">
          <div class="detail-item"><label>Experiencia</label><span id="m-exp"></span></div>
          <div class="detail-item"><label>Última empresa</label><span id="m-empresa"></span></div>
          <div class="detail-item"><label>Último cargo</label><span id="m-ucargo"></span></div>
          <div class="detail-item"><label>Profesión</label><span id="m-prof"></span></div>
          <div class="detail-item"><label>Universidad</label><span id="m-uni"></span></div>
          <div class="detail-item"><label>Referido por</label><span id="m-ref"></span></div>
        </div>
      </div>
      <div class="modal-section" id="m-proceso-section" style="display:none">
        <div class="section-label">Estado del proceso</div>
        <div class="detail-grid">
          <div class="detail-item"><label>Entrevistado por</label><span id="m-entpor"></span></div>
          <div class="detail-item" id="m-gerente-row" style="display:none"><label>Marcado en proceso por</label><span id="m-gerente-nombre"></span></div>
          <div class="detail-item" id="m-gcargo-row" style="display:none"><label>Cargo del gerente</label><span id="m-gerente-cargo"></span></div>
          <div class="detail-item" id="m-gfecha-row" style="display:none"><label>Fecha marcado</label><span id="m-gerente-fecha"></span></div>
        </div>
      </div>
      <div class="modal-actions">
        <a class="btn-action btn-primary" id="btn-cv" href="#" target="_blank">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          Ver hoja de vida
        </a>
        <a class="btn-action btn-secondary" id="btn-linkedin" href="#" target="_blank">
          <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          LinkedIn
        </a>
        <button id="btn-edit-modal" class="btn-edit-modal" onclick="window._leal&&window._leal.openEditPanel()">&#9998; Editar</button>
        <button id="btn-delete-modal" class="btn-delete-modal" onclick="window._leal&&window._leal.deleteCandidate(window._leal.currentIdx(),true)" style="display:none;">&#128465; Eliminar candidato</button>
      </div>
      <div class="modal-estado-actions" id="modal-estado-actions" style="margin-top:12px;"></div>
      <div class="proceso-note" id="proceso-note" style="display:none"></div>
      <div class="historial-section" id="historial-section" style="display:none">
        <div class="section-label">Historial de interacciones</div>
        <div class="historial-timeline" id="historial-timeline"></div>
      </div>
    </div>
  </div>
</div>

<script>
function openNuevo() {
  document.getElementById('modal-nuevo-overlay').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeNuevo() {
  document.getElementById('modal-nuevo-overlay').classList.remove('open');
  document.body.style.overflow = '';
}
function loadNuevos() {
  try { return JSON.parse(localStorage.getItem('leal_candidatos_nuevos_v1') || '[]'); } catch(e) { return []; }
}
function saveNuevos(arr) {
  try { localStorage.setItem('leal_candidatos_nuevos_v1', JSON.stringify(arr)); } catch(e) {}
}
function submitNuevo(e) {
  e.preventDefault();
  var nombre = document.getElementById('fn-nombre').value.trim();
  var cargo = document.getElementById('fn-cargo').value.trim();
  var referido = document.getElementById('fn-referido').value.trim();
  var email = document.getElementById('fn-email').value.trim();
  var telefono = document.getElementById('fn-telefono').value.trim();
  var linkedin = document.getElementById('fn-linkedin').value.trim();
  var profesion = document.getElementById('fn-profesion').value.trim();
  var universidad = document.getElementById('fn-universidad').value.trim();
  var experiencia = document.getElementById('fn-experiencia').value.trim();
  var empresa = document.getElementById('fn-empresa').value.trim();
  var ucargo = document.getElementById('fn-ucargo').value.trim();
  var resumen = document.getElementById('fn-resumen').value.trim();
  var cvfile = document.getElementById('fn-cvfile').value.trim();

  // Save to localStorage
  var nuevo = {
    nombre: nombre, cargo: cargo, referido_por: referido,
    fecha: new Date().toISOString().slice(0,10),
    email: email, telefono: telefono, linkedin: linkedin,
    profesion: profesion, universidad: universidad,
    experiencia: experiencia, ultima_empresa: empresa,
    ultimo_cargo: ucargo, resumen: resumen,
    estado: 'Disponible', entrevistado_por: '', cv_file: cvfile,
    _local: true
  };
  var nuevos = loadNuevos();
  nuevos.push(nuevo);
  saveNuevos(nuevos);

  // Add to in-memory candidatos and refresh grid
  if (window._leal) {
    var cands = window._leal.getCandidatos();
    cands.push(nuevo);
    window._leal.updateStats(cands);
    window._leal.applyFilters();
  }

  closeNuevo();
  document.getElementById('form-nuevo').reset();

  // Show confirmation
  var toast = document.getElementById('toast');
  toast.textContent = '✓ ' + nombre + ' guardado en el portal.';
  toast.classList.add('show');
  setTimeout(function() { toast.classList.remove('show'); }, 3000);
}

function generarPublicable() {
  var todos = CANDIDATOS.concat(loadNuevos());
  var jsonData = JSON.stringify(todos);
  function b64d(s) { return decodeURIComponent(escape(atob(s))); }
  var tb = b64d("");
  var ta = b64d("");
  var fullHtml = tb + "var CANDIDATOS = " + jsonData + ";" + ta;
  var banner = '<div id="__dl_banner" style="position:fixed;top:0;left:0;right:0;z-index:999999;background:#059669;padding:10px 24px;display:flex;align-items:center;gap:14px;font-family:DM Sans,sans-serif;box-shadow:0 2px 8px rgba(0,0,0,0.15)">' +
    '<span style="color:#fff;font-size:14px;font-weight:600;">Vista previa lista &#x2014; haz clic para descargar</span>' +
    '<button id="__dl_btn" style="background:#fff;color:#059669;border:none;padding:8px 22px;border-radius:8px;font-weight:700;cursor:pointer;font-size:14px">&#11015; Descargar Index_Referidos.html</button>' +
    '</div>' +
    '<script>document.getElementById("__dl_btn").addEventListener("click",function(){' +
    'var b=document.getElementById("__dl_banner");b.parentNode.removeChild(b);' +
    'var h=document.documentElement.outerHTML;' +
    'var bl=new Blob([h],{type:"text/html;charset=utf-8"});' +
    'var a=document.createElement("a");a.href=URL.createObjectURL(bl);a.download="Index_Referidos.html";' +
    'document.body.appendChild(a);a.click();document.body.removeChild(a);' +
    '});<\/script>';
  var fullWithBanner = fullHtml.replace('</body>', banner + '</body>');
  var blob = new Blob([fullWithBanner], {type: 'text/html;charset=utf-8'});
  var url = URL.createObjectURL(blob);
  window.open(url, '_blank');
  var t = document.getElementById("toast");
  t.textContent = "HTML publicable generado — listo para subir a GitHub.";
  t.classList.add("show");
  setTimeout(function() { t.classList.remove("show"); }, 3500);
}

function downloadReporte() {
  var headers = ['#','Nombre','Referido por','Fecha','Cargo propuesto','Profesión','Universidad',
    'Años experiencia','Última empresa','Último cargo','LinkedIn','Estado','Entrevistado por','Resumen'];
  var rows = [headers];
  var todos = CANDIDATOS.concat(loadNuevos());
  todos.forEach(function(c, i) {
    rows.push([i+1, c.nombre, c.referido_por, c.fecha, c.cargo, c.profesion, c.universidad,
      c.experiencia, c.ultima_empresa, c.ultimo_cargo, c.linkedin,
      c.estado || 'Disponible', c.entrevistado_por, c.resumen]);
  });
  var wb = XLSX.utils.book_new();
  var ws = XLSX.utils.aoa_to_sheet(rows);
  // Column widths
  ws['!cols'] = [4,28,20,12,22,22,28,16,26,24,32,14,18,60].map(function(w){return{wch:w};});
  // Bold header row
  var range = XLSX.utils.decode_range(ws['!ref']);
  for (var C = range.s.c; C <= range.e.c; C++) {
    var addr = XLSX.utils.encode_cell({r:0, c:C});
    if (ws[addr]) ws[addr].s = {font:{bold:true}};
  }
  XLSX.utils.book_append_sheet(wb, ws, 'Candidatos');
  XLSX.writeFile(wb, 'Referidos_Leal_' + new Date().toISOString().slice(0,10) + '.xlsx');
}
</script>
