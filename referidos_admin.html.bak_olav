var CANDIDATOS = [{"nombre": "Diana Marcela Cocuy Bocanegra", "referido_por": "Angie Rodríguez", "fecha": "2026-01-19", "cargo": "Business Analyst", "profesion": "Ingeniería Industrial", "universidad": "UNIVERSIDAD ESCUELA COLOMBIANA DE CARRERAS INDUSTRIALES.", "experiencia": "5 años y medio", "ultima_empresa": "WOM (PARTNERS TELECOM COLOMBIA SAS).", "ultimo_cargo": "Especialista BI", "resumen": "Ingeniera Industrial y Especialista en Analítica Estratégica de Datos, con sólida experiencia en análisis, modelado y visualización de datos para la toma de decisiones, dominio de SQL, Excel avanzado y Power BI. Perfil analítico y orientado a resultados, con participación en iniciativas de Business Intelligence, optimización de procesos y fuerte capacidad de trabajo en equipo y comunicación.", "linkedin": "https://www.linkedin.com/in/diana-marcela-cocuy-8b980b176/", "entrevistado_por": "Juan David", "estado": "Rechazado", "cv_file": "202601_HV DIANA MARCELA COCUY BOCANEGRA.pdf"}, {"nombre": "Maria Alejandra Moncada Agudelo", "referido_por": "Juliana Restrepo", "fecha": "2026-01-19", "cargo": "Data Scientist", "profesion": "Licenciada en Ingeniería Matemática", "universidad": "UNIVERSIDAD EAFIT", "experiencia": "4 años", "ultima_empresa": "Vensure Employer Solutions", "ultimo_cargo": "Data Scientist", "resumen": "Científico de Datos e Ingeniero Matemático con experiencia en ML, NLP y optimización, aplicando Python, R, SQL y Azure para resolver problemas de negocio. Logros destacados incluyen mejora del ROI de marketing en 20%, reducción de tiempos en ~70% y sólida capacidad para comunicar insights estratégicos a audiencias técnicas y no técnicas.", "linkedin": "https://www.linkedin.com/in/alejandra-moncada", "entrevistado_por": "", "estado": "Disponible", "cv_file": "MariaMoncada_englishCV.pdf"}, {"nombre": "Andrea Carvajal Maldonado", "referido_por": "Juliana Restrepo", "fecha": "2026-01-19", "cargo": "Data Analyst", "profesion": "Licenciada en Ingeniería Matemática", "universidad": "UNIVERSIDAD EAFIT", "experiencia": "4 años", "ultima_empresa": "Vensure Employer Solutions", "ultimo_cargo": "Data Analyst", "resumen": "Ingeniero matemático bilingüe con fuerte enfoque en análisis de datos, estadística y Machine Learning, con habilidades en Python, R, Matlab, SQL y Power BI. Destaca por su pensamiento lógico, liderazgo, trabajo en equipos interdisciplinarios y comunicación efectiva.", "linkedin": "https://www.linkedin.com/in/andreacarvajalm/", "entrevistado_por": "", "estado": "Disponible", "cv_file": "Andrea_Carvajal_CV2025.pdf"}, {"nombre": "Eduardo Garcia Llamas", "referido_por": "Nicole Castro", "fecha": "2026-01-19", "cargo": "Data Scientist", "profesion": "Ingeniería Industrial para la dirección", "universidad": "Universidad Anáhuac Querétaro", "experiencia": "5 años y medio", "ultima_empresa": "XERTICA.AI", "ultimo_cargo": "Data Scientist", "resumen": "Científico de Datos con experiencia en los sectores retail y tecnológico, enfocado en aplicar analítica avanzada para identificar oportunidades de crecimiento y eficiencia operativa. Perfil orientado al cliente y a la generación de valor estratégico a partir de los datos.", "linkedin": "https://www.linkedin.com/in/egllamas", "entrevistado_por": "", "estado": "Disponible", "cv_file": "CV Eduardo Garcia Llamas.pdf"}, {"nombre": "Astaroth Elizabethson", "referido_por": "Benjamín León", "fecha": "2026-01-19", "cargo": "Data Scientist", "profesion": "Licenciatura en Física, Licenciatura en Matemáticas", "universidad": "Universidad de los Andes", "experiencia": "16 años", "ultima_empresa": "BACU", "ultimo_cargo": "Analista de Control Operacional y Soporte de Datos", "resumen": "Físico y matemático con vocación docente, experiencia en educación y programación (Matlab, Java, R y SQL), especializado en Machine Learning supervisado aplicado a bases de datos astronómicas. Destaca por sus habilidades sociales, liderazgo, trabajo en equipo y capacidad para enseñar eficazmente.", "linkedin": "htt